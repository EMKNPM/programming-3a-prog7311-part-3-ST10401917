@model ServiceRequest

<h2>Create Service Request</h2>
<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post">

    <select asp-for="ContractId" class="form-control mb-2">
        <option value="">-- Select a Contract --</option>
        @{
            var contracts = ViewBag.Contracts as List<ContractReadDto> ?? new List<ContractReadDto>();
        }

        @foreach (var c in contracts)
        {
            <option value="@c.ContractId">
                @c.ClientName - #@c.ContractId (@c.Status)
            </option>
        }
    </select>
    <span asp-validation-for="ContractId" class="text-danger"></span>

    <div class="form-group">
        <input asp-for="Description" class="form-control mb-2" placeholder="Description" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <input asp-for="CostUSD" id="usd" class="form-control mb-2" placeholder="USD" />
    <span asp-validation-for="CostUSD" class="text-danger"></span>

    <div class="alert alert-info mb-2">
        Estimated ZAR: R <span id="zar-display">0.00</span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
</form>

<script>
    // Your JavaScript remains exactly the same as it targets the IDs
    document.getElementById("usd").addEventListener("input", async function () {
        let res = await fetch('/ServiceRequests/GetRate');
        if (res.ok) {
            let rate = await res.json();
            let usdVal = parseFloat(this.value) || 0;
            document.getElementById("zar").value = (usdVal * rate).toFixed(2);
        }
    });
</script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>